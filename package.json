  "description": "WhatsApp Bot Premium",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --update-env",
    "pm2:restart": "pm2 restart luxx --update-env",
    "pm2:save": "pm2 save",
    "pm2:status": "pm2 status luxx",
    "watch:setup": "node scripts/setup-public-watch.mjs",
