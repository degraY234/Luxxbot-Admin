    "portfolio:domain": "node scripts/enable-portfolio-domain.mjs"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@distube/ytdl-core": "^4.16.12",
    "@google/genai": "^2.8.0",
    "@hapi/boom": "^10.0.1",
    "@noble/ciphers": "^2.2.0",
    "@tobyg74/tiktok-api-dl": "^1.3.7",
    "@whiskeysockets/baileys": "^6.7.23",
    "axios": "^1.17.0",
    "canvas": "^3.2.3",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "discord.js": "^14.26.4",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "openai": "^4.104.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sodium-native": "^5.1.0",
