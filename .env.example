# WhatsApp Bot — LuxxBot
GEMINI_API_KEY=
OPENAI_API_KEY=

# Grok / xAI (format key: xai-...)
GROK_API_KEY=
XAI_API_KEY=

# Groq.com ASLI (format key: gsk_...)
GROQ_API_KEY=
GROQ_API_KEY_ALT=

STREAM_TOKEN=
STABLE_HORDE_API_KEY=

# Gambar !buat HD — BytePlus ModelArk (utama, Seedream)
# Key dari https://console.byteplus.com/ark (format ark-...)
MODEL_ARK_API_KEY=
MODEL_ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
MODEL_ARK_IMAGE_MODEL=seedream-4-5-251128

# Gambar !buat — Pollinations (cadangan)
POLLINATIONS_KEY=

# Fallback gambar !buat (opsional)
HF_TOKEN=
HUGGINGFACE_API_KEY=
TOGETHER_API_KEY=
PM2_APP_NAME=luxx

# Luxx Watch — mirror LK21 yang bisa diakses (opsional, default lk21.us)
LK21_BASE_URL=https://lk21.us

# Radio web player
RADIO_PORT=3920
# URL yang dikirim ke !radio
# PC rumah + tunnel : scripts/radio-tunnel.ps1 → paste URL trycloudflare (jendela tunnel harus tetap buka)
# Oracle Cloud VPS  : http://IP-PUBLIK-VPS:3920
# LAN saja          : http://192.168.x.x:3920
RADIO_PUBLIC_URL=http://localhost:3920
RADIO_BIND_HOST=0.0.0.0

# Portofolio pembuat (!aboutlux)
PORTFOLIO_URL=https://degray234.github.io/PortoDoxxborx/

# Admin panel (folder admin/ — bisa di-host GitHub Pages, API di server bot)
ADMIN_API_TOKEN=ganti-token-rahasia-panjang
# Origin GitHub Pages kamu, misal: https://username.github.io
ADMIN_CORS_ORIGIN=*

# Fakta pagi otomatis (tidak perlu command — kirim ke grup jam 07:00 WIB)
DAILY_FACT_ENABLED=true
DAILY_FACT_HOUR=7
DAILY_FACT_MINUTE=0
# JID grup WA (pisah koma). Contoh: 120363123456789012@g.us
DAILY_FACT_GROUP_JIDS=

# Discord
DISCORD_BOT_TOKEN=
# Wajib untuk slash command cepat (muncul detik, bukan 1 jam)
DISCORD_GUILD_ID=
DISCORD_CLIENT_ID=
# true = daftar slash global (lambat). Default: guild-only via DISCORD_GUILD_ID
DISCORD_REGISTER_GLOBAL=false
# true = bot merespons teks !join / mention di channel (butuh intent di Developer Portal)
DISCORD_MESSAGE_CONTENT=false
DISCORD_SERVER_INVITE=https://discord.gg/QJQVDfvx
DISCORD_SERVER_NAME=DoxxBorx's server
DISCORD_PREFIX=!

# Cuaca (!cuaca) — otomatis, tidak perlu API key
# WEATHER_API_KEY= (legacy, tidak dipakai)
# OPENWEATHER_API_KEY= (legacy, tidak dipakai)

# YouTube di server (Railway) — wajib cookies sekali, tersimpan di volume persist
# Export di PC: scripts/export-youtube-cookies.ps1
# YTDLP_COOKIES_FILE=/app/persist/data/youtube-cookies.txt
# YTDLP_PO_TOKEN= (opsional, dari YouTube account)

# VPS / Zelpstore (PM2) — wajib untuk backup session & cookies
# PERSIST_DIR=/home/ubuntu/luxxbot/persist

# Railway / Docker (opsional — auto dari RAILWAY_PUBLIC_DOMAIN)
# PERSIST_DIR=/app/persist
# RAILWAY_PUBLIC_DOMAIN=luxxbot-production.up.railway.app

# GitHub repo bot (untuk deploy script)
# GITHUB_REPO=https://github.com/degraY234/Luxxbot-Admin.git
# GITHUB_BRANCH=feature/railway-deploy